            "source": [
                "import matplotlib.pyplot as plt\n",
                "import numpy as np\n",
                "#setting random seed\n",
                "np.random.seed(50)\n",
                "def simulate_ant_walk(\n",
                "    food_pos, start_pos=(0.0, 0.0), m=0.1, max_steps=1000, seed=None\n",
                "):\n",
                "    \"\"\"Simulates the 2D random walk of an ant searching for food with distance-dependent\n",
                "\n",
                "    angular noise.\n",
                "\n",
                "    Parameters:\n",
                "    -----------\n",
                "    food_pos : array-like, shape (2,)\n",
                "        Target coordinates of the food [x_f, y_f].\n",
                "    start_pos : array-like, shape (2,), optional\n",
                "        Initial coordinates of the ant [x_0, y_0]. Default is (0.0, 0.0).\n",
                "    m : float, optional\n",
                "        Scaling factor for angular uncertainty: sigma_theta = m * d. Default is 0.1.\n",
                "    max_steps : int, optional\n",
                "        Maximum number of steps before terminating search (N). Default is 1000.\n",
                "    seed : int, optional\n",
                "        Random seed for reproducibility.\n",
                "\n",
                "    Returns:\n",
                "    --------\n",
                "    trajectory : np.ndarray, shape (num_steps + 1, 2)\n",
                "        Sequence of ant coordinates visited from start to finish.\n",
                "    success : bool\n",
                "        True if food was reached within max_steps, False otherwise.\n",
                "    steps : int\n",
                "        Number of steps taken to reach food (or max_steps if unsuccessful).\n",
                "    \"\"\"\n",
                "    if seed is not None:\n",
                "        np.random.seed(seed)\n",
                "\n",
                "    food = np.array(food_pos, dtype=float)\n",
                "    current_pos = np.array(start_pos, dtype=float)\n",
                "\n",
                "    trajectory = [current_pos.copy()]\n",
                "    success = False\n",
                "\n",
                "    for step in range(1, max_steps + 1):\n",
                "        disp = food - current_pos\n",
                "        d = np.linalg.norm(disp)\n",
                "\n",
                "        # Reached food criterion\n",
                "        if d < 1.0:\n",
                "            trajectory.append(food.copy())\n",
                "            success = True\n",
                "            return np.array(trajectory), success, step\n",
                "\n",
                "        # Direction mean and standard deviation\n",
                "        mu_theta = np.arctan2(disp[1], disp[0])\n",
                "        sigma_theta = m * d\n",
                "\n",
                "        # Sample heading angle\n",
                "        theta = np.random.normal(mu_theta, sigma_theta)\n",
                "\n",
                "        # Unit displacement step\n",
                "        current_pos = current_pos + np.array([np.cos(theta), np.sin(theta)])\n",
                "        trajectory.append(current_pos.copy())\n",
                "\n",
                "    return np.array(trajectory), success, max_steps\n"
            ]
        },
