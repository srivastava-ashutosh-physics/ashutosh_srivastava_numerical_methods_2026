            "source": [
                "target_successful_ants = 100\n",
                "successful_steps = []\n",
                "unsuccessful_count = 0\n",
                "\n",
                "while len(successful_steps) < target_successful_ants:\n",
                "    _, success, steps = simulate_ant_walk(\n",
                "        food_pos=food_pos_q2, start_pos=start_pos_q2, m=m_val, max_steps=N_val\n",
                "    )\n",
                "    if success:\n",
                "        successful_steps.append(steps)\n",
                "    else:\n",
                "        unsuccessful_count += 1\n",
                "\n",
                "successful_steps = np.array(successful_steps)\n",
                "mean_steps = np.mean(successful_steps)\n",
                "std_steps = np.std(successful_steps, ddof=1)\n",
                "\n",
                "print(\n",
                "    f\"Successful ants recorded: {len(successful_steps)}\"\n",
                ")  # Output: 100[span_9](start_span)[span_9](end_span)\n",
                "print(f\"Mean number of steps: {mean_steps:.2f}\")\n",
                "print(f\"Standard deviation of steps: {std_steps:.2f}\")\n",
                "print(f\"Number of unsuccessful ants: {unsuccessful_count}\")\n"
            ]
        },
