            "source": [
                "food_pos_q2 = [10.0, 20.0]\n",
                "start_pos_q2 = [0.0, 0.0]\n",
                "m_val = 0.1\n",
                "N_val = 1000\n",
                "\n",
                "trajectory, success, steps = simulate_ant_walk(\n",
                "    food_pos=food_pos_q2,\n",
                "    start_pos=start_pos_q2,\n",
                "    m=m_val,\n",
                "    max_steps=N_val,\n",
                "    seed=10,\n",
                ")\n",
                "\n",
                "plt.figure(figsize=(7, 7), dpi=100)\n",
                "plt.plot(\n",
                "    trajectory[:, 0],\n",
                "    trajectory[:, 1],\n",
                "    \"-\",\n",
                "    color=\"darkblue\",\n",
                "    linewidth=1.2,\n",
                "    alpha=0.8,\n",
                "    label=\"Ant Path\",\n",
                ")\n",
                "plt.plot(\n",
                "    start_pos_q2[0],\n",
                "    start_pos_q2[1],\n",
                "    \"go\",\n",
                "    markersize=9,\n",
                "    label=f\"Start {start_pos_q2}\",\n",
                ")\n",
                "plt.plot(\n",
                "    food_pos_q2[0],\n",
                "    food_pos_q2[1],\n",
                "    \"r*\",\n",
                "    markersize=13,\n",
                "    label=f\"Food {food_pos_q2}\",\n",
                ")\n",
                "\n",
                "plt.title(\n",
                "    f\"Ant Trajectory towards Food (Success: {success}, Steps: {steps})\",\n",
                "    fontsize=12,\n",
                "    fontweight=\"bold\",\n",
                ")\n",
                "plt.xlabel(r\"$x$\", fontsize=11)\n",
                "plt.ylabel(r\"$y$\", fontsize=11)\n",
                "plt.grid(True, linestyle=\"--\", alpha=0.6)\n",
                "plt.legend(frameon=True, facecolor=\"white\", framealpha=0.9)\n",
                "plt.axis(\"equal\")\n",
                "plt.tight_layout()\n",
                "plt.show()\n"
            ]
        },
